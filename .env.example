STORAGE_PROVIDER=local
UPLOAD_DIR=.data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TRUST_PROXY=false
INITIAL_ADMIN_EMAIL=mari@admin.com.br
