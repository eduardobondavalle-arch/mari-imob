DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
# Em producao, use o pooler do Supabase em DATABASE_URL e a conexao direta
# somente para `npm run db:migrate`.
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=2
APP_ENV=development
PRESENTATION_MODE=false
DEMO_MODE=false
SITE_URL=http://127.0.0.1:3000
